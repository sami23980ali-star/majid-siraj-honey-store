# متجر ماجد سراج — متغيرات البيئة
# انسخ هذا الملف إلى `.env` واملأ القيم قبل التشغيل أو الرفع.
# لا ترفع `.env` إلى المستودع: فيه أسرار الإنتاج.

# ── إلزامية للتشغيل الكامل ─────────────────────────────────────────────
# سلسلة اتصال MySQL. بدونها يقلع التطبيق لكن الكتالوج يبقى فارغًا،
# ولوحة الإدارة تعرض «تعذر التحقق من صلاحية الدخول» وتجيب الواجهة بـ 503.
DATABASE_URL=mysql://user:password@host:3306/majid_siraj

# سر توقيع كوكي الجلسة (JWT). استخدم قيمة عشوائية طويلة خاصة بكل بيئة.
JWT_SECRET=

# خدمة تسجيل الدخول (OAuth). بدونها لا يعمل دخول مالك المشروع،
# ويسجّل الخادم عند الإقلاع: OAUTH_SERVER_URL is not configured.
OAUTH_SERVER_URL=

# معرّف حساب مالك المشروع. املأه قبل فتح النطاق للناس: هو الطريقة المقصودة
# لقصر إعداد أول حساب مدير على هويتك وحدها. تحصل على القيمة بتسجيل دخولك
# ثم قراءة `openId` من مسار auth.me.
OWNER_OPEN_ID=

# رمز إعداد لمرة واحدة، وهو المنفذ الاحتياطي فقط عندما لا تعرف OWNER_OPEN_ID
# بعد. عندما يكون مهيّأً، يستطيع أي حساب موثّق فتح شاشة الإعداد لكنه يُطالب
# بكتابة هذا الرمز بالضبط. استخدم قيمة عشوائية طويلة، واحذف المتغيّر بعد
# إنشاء الحساب. إن بقي المتغيّران فارغين فلا يستطيع أحد إنشاء أول حساب مدير.
ADMIN_SETUP_TOKEN=

# ── تخزين الوسائط (صور المنتجات والمراجعات) ────────────────────────────
# بدونهما يجيب مسار /manus-storage/* بـ 500 «Storage proxy not configured»
# وتظهر صورة بديلة بهوية المتجر بدل الإطار المكسور.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── الدفع الإلكتروني عبر Shopify (اختياري) ─────────────────────────────
# بدونهما يبقى الطلب عبر واتساب فقط، ويُخفى زر الدفع الإلكتروني.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# ── إعدادات التشغيل (لها قيم افتراضية آمنة) ────────────────────────────
NODE_ENV=production
PORT=3000
# عدد الوسائط العكسية أمام التطبيق. قيمة أعلى من الواقع تتيح للعميل
# تزييف عنوانه في x-forwarded-for وتخريب حدود المعدل. الافتراضي 1.
TRUST_PROXY_HOPS=1
# lax افتراضيًا. اجعلها none فقط عند تقديم المتجر داخل إطار خارجي،
# لأن قيمة none تفتح الكوكي لطلبات المواقع الأخرى.
SESSION_COOKIE_SAMESITE=lax

# ── متغيرات الواجهة (تُحقن وقت البناء، فلا تضع فيها أي سر) ──────────────
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
# تحليلات umami اختيارية. إن تركتها فارغة يُحذف الوسم من الصفحة.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── اختبارات المتصفح في scripts/ فقط ───────────────────────────────────
# STORE_URL=http://127.0.0.1:3000
# E2E_WIDTH=1280
